# 复制为 deploy/.env 后按学校修改（勿提交真实密钥）
# cp .env.example .env   或 Windows: Copy-Item .env.example .env

# Web 访问端口（默认 80，冲突可改为 8088）
WEB_PORT=80

# 数据库
DB_USERNAME=ensp
DB_PASSWORD=ChangeMe_Db_2026
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026

# JWT（至少 32 字符，每校随机生成）
AUTH_JWT_SECRET=ensp-nms-change-this-jwt-secret-32b-min

# 浏览器访问来源（经 Nginx 同源一般不必改；若用 IP:端口直访可追加）
AUTH_CORS_ORIGINS=http://localhost,http://127.0.0.1

# 实例展示信息（登录页 / 侧栏，可选）
NMS_LICENSE_CUSTOMER=Demo Lab
NMS_LICENSE_SKU=Community
NMS_LICENSE_EXPIRES=
NMS_LICENSE_INSTANCE=

# JVM（可选）
JAVA_OPTS=-Xms256m -Xmx768m
